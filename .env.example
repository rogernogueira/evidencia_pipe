# evidencia_pipe — variáveis de ambiente (copie para .env e ajuste).
# NÃO comite segredos reais.

# --- Estágio 1: DSpace (RDApp) ---
# Bitstreams são baixados de {DSPACE_URL}/server/api/core/bitstreams/{uuid}/content
DSPACE_URL=https://rdapp.comais.uft.edu.br

# --- Estágio 2: MinerU (container mineru-api, profile "api") ---
MINERU_API_URL=http://127.0.0.1:8010

# --- Estágio 3: Qdrant (persistência vetorial) ---
QDRANT_URL=http://192.168.105.8:6333
QDRANT_COLLECTION=evidencia_chunks

# --- Enriquecimento por LLM (DESACOPLADO — OpenAI-compatible) ---
# O enrich NÃO faz parte da chain obrigatória de indexação. Ele roda como follow-up
# OPCIONAL após a indexação (ou sob demanda em /api/files/enrich/{job_id}) e propaga
# os metadados ao Qdrant via set_payload. Sem chave configurada, é pulado e a
# indexação segue normalmente.
#
# Provedor lógico (define os defaults de base_url/model): deepseek | openai | ...
LLM_ENRICH_PROVIDER=deepseek
# Chave/endpoint/modelo genéricos. Se em branco, herdam os defaults do provedor.
LLM_ENRICH_API_KEY=
LLM_ENRICH_BASE_URL=
LLM_ENRICH_MODEL=
# Follow-up automático do enrich APÓS a indexação (no-op sem chave). Default: true.
LLM_ENRICH_AUTO=true
# LLM_ENRICH_MAX_CHARS=220000
# LLM_ENRICH_REVIEW_THRESHOLD=0.6
#
# Compatibilidade: os nomes legados DEEPSEEK_* ainda são lidos como fallback.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# --- Orquestração: Celery + Redis ---
# Redis é o broker do Celery e o backing do job_store (status compartilhado
# entre a API e os workers). DB 0 = broker, DB 1 = job_store.
REDIS_URL=redis://127.0.0.1:6379
# Sobrescreva se o broker/backing ficarem em hosts distintos:
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# JOBSTORE_REDIS_URL=redis://127.0.0.1:6379/1
# JOBSTORE_TTL=604800   # 7 dias

# --- Robustez: timeouts e limites de execução ---
# Limite por task Celery (s). Ordem: MINERU_TIMEOUT < soft < hard < visibility(3600).
# soft levanta SoftTimeLimitExceeded (registra falha); hard mata o worker. 0 = sem limite.
# CELERY_TASK_SOFT_TIME_LIMIT=3000    # 50 min
# CELERY_TASK_TIME_LIMIT=3300         # 55 min
# Timeout do subprocesso do MinerU (s); ao estourar, encerra o grupo e falha. 0 = sem limite.
# MINERU_TIMEOUT_SECONDS=2400         # 40 min
# Timeout dos clientes externos (s):
# LLM_ENRICH_TIMEOUT_SECONDS=120
# QDRANT_TIMEOUT_SECONDS=60
# Falhas: jobs em erro entram numa fila leve (GET /api/files/failures);
# reprocesse com POST /api/files/reprocess/{job_id}.

# --- Coordenação da GPU compartilhada (gpu_resource_manager) ---
# Redis EXCLUSIVO do gerenciador da GPU. NÃO reutilize DB 0 (broker) nem DB 1
# (job_store). Todos os consumidores (MinerU, BGE-M3, scripts externos) precisam
# apontar para o MESMO Redis e usar o MESMO GPU_RESOURCE_NAME para se coordenarem.
GPU_MANAGER_ENABLED=true
# Dentro do docker-compose use o nome do serviço; workers/scripts no HOST (ver
# CELERY.md) devem usar redis://127.0.0.1:6379/2 (mesmo Redis, DB 2).
GPU_MANAGER_REDIS_URL=redis://redis:6379/2
GPU_RESOURCE_NAME=gpu0

GPU_MANAGER_LOCK_TTL_SECONDS=300
GPU_MANAGER_HEARTBEAT_SECONDS=30
GPU_MANAGER_WAIT_TIMEOUT_SECONDS=1800

GPU_MANAGER_DEFAULT_PRIORITY=50
GPU_MANAGER_AGING_ENABLED=true
GPU_MANAGER_AGING_INTERVAL_SECONDS=300
GPU_MANAGER_AGING_STEP=1

# Prioridades dos consumidores internos (menor número = maior prioridade).
# Esquema: externo (10) < índice bge-m3 (15) < extração MinerU (20). O índice é MAIS
# prioritário que a extração de propósito — evita que o índice (rápido) seja "starved"
# pelo backlog de extrações (longas) em lotes grandes. Não há preempção: só muda a
# ordem da fila de espera.
MINERU_GPU_PRIORITY=20
BGE_GPU_PRIORITY=15

# Ciclo de vida do BGE-M3 na VRAM: preload | lazy | cpu_idle | unload.
# Para GPU compartilhada, o padrão é lazy + descarregar após a task.
BGE_GPU_LIFECYCLE=lazy
BGE_UNLOAD_AFTER_TASK=true
GPU_SHARED_WITH_MINERU=true

# --- Armazenamento de artefatos (MinIO / S3-compatível) ---
# Fonte OFICIAL dos artefatos do pipeline (PDF, markdown, JSON MinerU, chunks,
# relatórios, manifesto). A Celery chain transporta SÓ referências minio://.
# Em produção: use credenciais próprias (NÃO minioadmin), TLS (MINIO_SECURE=true)
# e um usuário do pipeline com política de menor privilégio.
ARTIFACT_STORE_BACKEND=minio
# Endpoint host:port SEM esquema. No compose use "minio:9000"; workers/scripts no
# HOST usam "127.0.0.1:9000".
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_REGION=us-east-1

MINIO_BUCKET=evidencia-pipe
MINIO_ARTIFACT_PREFIX=artifacts

MINIO_AUTO_CREATE_BUCKET=true
MINIO_BUCKET_VERSIONING=true

MINIO_CONNECT_TIMEOUT_SECONDS=5
MINIO_READ_TIMEOUT_SECONDS=60
MINIO_MAX_RETRIES=3

MINIO_MULTIPART_THRESHOLD_MB=64
MINIO_PART_SIZE_MB=16

MINIO_PRESIGNED_URL_TTL_SECONDS=900

MINIO_SERVER_SIDE_ENCRYPTION_ENABLED=false
MINIO_SERVER_SIDE_ENCRYPTION_TYPE=SSE-S3
MINIO_HEALTHCHECK_WRITE=true

MINIO_DOWNLOAD_CHUNK_SIZE_MB=8
MINIO_UPLOAD_CHUNK_SIZE_MB=16

# Credenciais root do serviço MinIO no docker-compose (NÃO usar em produção).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Retenção / limpeza de artefatos (executada FORA da chain) ---
ARTIFACT_TEMP_DIR=/tmp/evidencia-pipe
ARTIFACT_RETENTION_DAYS=30
ARTIFACT_TEMP_RETENTION_HOURS=24
ARTIFACT_KEEP_FAILED_JOBS=true
ARTIFACT_KEEP_SOURCE_PDF=true
ARTIFACT_KEEP_MINERU_OUTPUT=true
ARTIFACT_KEEP_CHUNKS=true
ARTIFACT_KEEP_LOCAL_TEMP_ON_FAILURE=false

# --- Enriquecimento LLM / chunks / embeddings ---
LLM_MAX_INPUT_ARTIFACT_BYTES=10485760
ARTIFACT_KEEP_LLM_RAW_RESPONSE=false
CHUNK_FILE_FORMAT=jsonl
EMBEDDING_BATCH_SIZE=32
QDRANT_UPSERT_BATCH_SIZE=100

# --- Chunking estrutural por tokens (StructuralTokenChunker) ---
# Estratégia padrão: structural_tokens (limites em TOKENS do BGE-M3, preserva
# seções/páginas/tabelas/listas). legacy_chars = chunker antigo (por caracteres),
# mantido para comparação. Toda a tokenização roda em CPU, FORA do lock da GPU.
CHUNKING_STRATEGY=structural_tokens
CHUNKING_VERSION=structural-token-v1

CHUNK_TOKENIZER_MODEL=BAAI/bge-m3
CHUNK_TOKENIZER_USE_FAST=true
CHUNK_TOKENIZER_FALLBACK_ENABLED=true

CHUNK_TARGET_TOKENS=512
CHUNK_MAX_TOKENS=768
CHUNK_MIN_TOKENS=80

CHUNK_OVERLAP_TOKENS=64
CHUNK_MAX_OVERLAP_TOKENS=128

CHUNK_TABLE_MAX_TOKENS=1024
CHUNK_LIST_MAX_TOKENS=768
CHUNK_FORCE_SPLIT_ABOVE_TOKENS=1536

CHUNK_EMBED_DOCUMENT_TITLE=true
CHUNK_EMBED_SECTION_CONTEXT=true

CHUNK_REMOVE_REPEATED_HEADERS=true
CHUNK_REMOVE_REPEATED_FOOTERS=true
CHUNK_KEEP_FOOTNOTES=true

# include | separate | exclude
CHUNK_REFERENCES_MODE=separate

# text | contextualized_text
EMBEDDING_TEXT_FIELD=contextualized_text

# --- Chunker legado (por caracteres) — preservado temporariamente ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=250
MIN_CHUNK_CHARS=300

# --- Barreira anti-regressão do payload da Celery chain ---
CELERY_CHAIN_MAX_PAYLOAD_BYTES=16384
CELERY_CHAIN_ENFORCE_LIGHTWEIGHT_CONTEXT=true
PIPELINE_VERSION=2.0

# Lock do manifesto (curto). Por padrão reusa o Redis do job_store (DB 1).
# MANIFEST_LOCK_REDIS_URL=redis://127.0.0.1:6379/1
MANIFEST_LOCK_TTL_SECONDS=30

# Token dos endpoints internos (presigned URL). Vazio = liberado só em dev.
INTERNAL_API_TOKEN=

# --- Servidor ---
PORT=8020
