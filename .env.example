# evidencia_pipe — variáveis de ambiente (copie para .env e ajuste).
# NÃO comite segredos reais.

# --- Estágio 1: DSpace (RDApp) ---
# Bitstreams são baixados de {DSPACE_URL}/server/api/core/bitstreams/{uuid}/content
DSPACE_URL=https://rdapp.comais.uft.edu.br

# --- Estágio 2: MinerU (container mineru-api, profile "api") ---
MINERU_API_URL=http://127.0.0.1:8010

# --- Estágio 3: Qdrant (persistência vetorial) ---
QDRANT_URL=http://192.168.105.8:6333
QDRANT_COLLECTION=evidencia_chunks

# --- Estágio 4: LLM DeepSeek (OpenAI-compatible) ---
# Sem DEEPSEEK_API_KEY o estágio de enriquecimento é pulado (best-effort).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Orquestração: Celery + Redis ---
# Redis é o broker do Celery e o backing do job_store (status compartilhado
# entre a API e os workers). DB 0 = broker, DB 1 = job_store.
REDIS_URL=redis://127.0.0.1:6379
# Sobrescreva se o broker/backing ficarem em hosts distintos:
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# JOBSTORE_REDIS_URL=redis://127.0.0.1:6379/1
# JOBSTORE_TTL=604800   # 7 dias

# --- Servidor ---
PORT=8020
