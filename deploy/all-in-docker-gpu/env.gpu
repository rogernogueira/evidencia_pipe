# Sobrescritas para o stack TUDO-EM-DOCKER com GPU LOCAL.
# Carregado depois do .env da raiz. Diferença central vs. o modelo híbrido de hoje:
# a API e os workers também viram contêiner (não ficam no venv/systemd do host).

# --- Infra local (rede do compose) --------------------------------------------
# REDIS_URL é a BASE sem DB: o código deriva broker /0, job_store /1, gpu_manager /2.
# NÃO ponha /0 aqui (viraria /0/0 no broker e o worker quebra).
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=minio:9000
QDRANT_URL=http://qdrant:6333
# A API escuta na porta publicada pelo compose; sem isto herdaria PORT do .env raiz (8181).
PORT=8020

# --- Coordenação da GPU local -------------------------------------------------
# Há UMA GPU física compartilhada entre MinerU (extract) e o embedding (index):
# o mutex serializa os estágios de GPU dos workers para não estourar a VRAM.
GPU_MANAGER_ENABLED=true
GPU_MANAGER_REDIS_URL=redis://redis:6379/2
# GPU_RESOURCE_NAME=gpu0   # default; mantenha IGUAL entre worker-light e worker-index.

# --- MinerU (estágio 2) — contêiner GPU local ---------------------------------
# Default: backend pipeline (VRAM ~6,5 GB). Para VLM/hybrid, aponte para o serviço
# `mineru` (porta interna 8010 também) e use MINERU_BACKEND=hybrid-engine — exige
# ~24 GB livres na GPU (ver README e DEPLOY.md).
MINERU_API_URL=http://mineru-pipeline:8010
MINERU_BACKEND=pipeline

# --- Embedding (estágio 3) — dois contêineres vLLM GPU ------------------------
EMBED_API_URL=http://vllm-bge-m3:8000           # task embed (denso)
EMBED_API_SPARSE_URL=http://vllm-bge-m3-sparse:8001   # task token_classify (esparso)
