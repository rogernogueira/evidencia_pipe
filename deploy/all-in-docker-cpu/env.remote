# Sobrescritas para rodar a infra+app AQUI e BGE+MinerU em OUTRO host (com GPU).
# Carregado depois do .env da raiz. É o "Cenário B" do DEPLOY.md, mas com a app
# em contêiner (não no venv do host).
#
# Troque GPU_HOST pelo IP/hostname do host de GPU (ex.: 172.16.115.60).

# --- Infra local (rede do compose) --------------------------------------------
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
QDRANT_URL=http://qdrant:6333

# --- MinerU (estágio 2) — REMOTO ----------------------------------------------
MINERU_API_URL=http://GPU_HOST:8011
# TEM de casar com o backend que roda LÁ. Enum válido:
#   pipeline · vlm-engine · hybrid-engine · vlm-http-client · hybrid-http-client
# (confirme no /openapi.json do servidor — ver DEPLOY.md passo 10).
MINERU_BACKEND=hybrid-engine

# --- Embedding (estágio 3) — REMOTO, DUAS instâncias --------------------------
# Uma serve a task `embed` (denso), outra `token_classify` (esparso). Um vLLM só
# atende UMA task — não aponte as duas para a mesma porta.
EMBED_API_URL=http://GPU_HOST:8000          # task embed  (vetor denso)
EMBED_API_SPARSE_URL=http://GPU_HOST:8001   # task token_classify (vetor esparso)

# --- GPU manager --------------------------------------------------------------
# A GPU não é deste host: o lock serializaria chamadas HTTP a uma placa remota
# à toa. Desligado (DEPLOY.md passo 10).
GPU_MANAGER_ENABLED=false
