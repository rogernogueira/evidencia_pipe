# Sobrescritas para o stack TUDO-EM-DOCKER CPU-only.
#
# Carregado DEPOIS do .env da raiz (env_file: [../../.env, ./env.cpu]), então só
# o que muda em relação ao modelo híbrido entra aqui: endereços de 127.0.0.1 →
# nome de serviço na rede do compose, e os backends CPU.

# --- Redis (broker/job_store/gpu_manager) -------------------------------------
# No host era 127.0.0.1; aqui é o serviço `redis` na rede do compose.
REDIS_URL=redis://redis:6379/0
GPU_MANAGER_REDIS_URL=redis://redis:6379/2

# --- MinIO --------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000

# --- Qdrant (agora dentro do compose) -----------------------------------------
QDRANT_URL=http://qdrant:6333

# --- MinerU (estágio 2) — backend pipeline em CPU -----------------------------
MINERU_API_URL=http://mineru-cpu:8010
MINERU_BACKEND=pipeline

# --- Embedding (estágio 3) — UM contêiner CPU serve denso e esparso -----------
EMBED_API_URL=http://bge-m3-cpu:8000
EMBED_API_SPARSE_URL=http://bge-m3-cpu:8000
