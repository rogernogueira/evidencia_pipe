# Worker de GPU do evidencia_pipe: fila gpu (chunking + embedding + upsert no Qdrant).
# O bge-m3 NÃO roda mais aqui — o embedding é HTTP contra os contêineres vLLM (ver
# evidencia-compose.service). WORKER_ROLE=gpu faz o worker sondar a API na subida.
# concurrency=1 continua: a fila serializa o trabalho pesado por documento.
[Unit]
Description=evidencia_pipe - worker de GPU (embedding + Qdrant)
Requires=evidencia-compose.service
After=evidencia-compose.service
PartOf=evidencia.target

[Service]
Type=simple
WorkingDirectory=/app/evidencia_pipe
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=WORKER_ROLE=gpu
ExecStart=/root/.local/bin/uv run celery -A backend.celery_app worker -Q gpu -c 1 -E -n gpu@%%h
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
